#!/bin/sh
# Self-test for the guide lint. Every rule in the Guide style must fire on the
# fixture, and Vale must exit non-zero on it.
set -u
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root" || exit 1
status=0

# Vale matches its config globs against relative paths, so run from the root.
if output=$(vale --config .vale.ini --output=line .vale/fixtures/violations.md); then
  echo "test: vale exited 0 on the fixture; it must fail" >&2
  status=1
fi

for rule in .vale/styles/Guide/*.yml; do
  name=$(basename "$rule" .yml)
  if printf '%s\n' "$output" | grep -q "Guide\.$name"; then
    echo "test: Guide.$name fires"
  else
    echo "test: Guide.$name is silent on the fixture" >&2
    status=1
  fi
done

exit $status
